{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vhs-familia",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-04-01",
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "vhs-familia" }
  ],
  "vars": { "SITE_HOSTNAME": "vhs.tiarlesbutzk.com.br" }
}
